{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/edit-quiz/**",
        "destination": "/edit-quiz/index.html"
      },
      {
        "source": "/datenschutz/**",
        "destination": "/assets/assets/datenschutz.html"
      },
      {
        "source": "/impressum/**",
        "destination": "/assets/assets/impressum.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
